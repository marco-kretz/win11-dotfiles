# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Applied by chezmoi (run_onchange_after_winget-configure.ps1.tmpl) whenever this file changes.
# Manual:  winget configure -f configuration.winget
# Check:   winget configure test -f configuration.winget
# Disable a tweak by commenting out its resource block. Removing a block does not revert
# the value on machines where it was already applied (see README).
properties:
  configurationVersion: 0.2.0
  resources:
    # --- Apps ---------------------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: windhawk
      directives:
        description: Install Windhawk
        securityContext: elevated
      settings:
        id: RamenSoftware.Windhawk
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: discord
      directives:
        description: Install Discord.Discord
      settings:
        id: Discord.Discord
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: teams
      directives:
        description: Install Microsoft.Teams
      settings:
        id: Microsoft.Teams
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: spotify
      directives:
        description: Install Spotify.Spotify
      settings:
        id: Spotify.Spotify
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: steam
      directives:
        description: Install Valve.Steam
      settings:
        id: Valve.Steam
        source: winget

    # --- Dev ----------------------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: git
      directives:
        description: Install Git.Git
      settings:
        id: Git.Git
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: powershell
      directives:
        description: Install Microsoft.PowerShell
      settings:
        id: Microsoft.PowerShell
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: windows-terminal
      directives:
        description: Install Microsoft.WindowsTerminal
      settings:
        id: Microsoft.WindowsTerminal
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wsl
      directives:
        description: Install Microsoft.WSL
      settings:
        id: Microsoft.WSL
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vscode
      directives:
        description: Install Microsoft.VisualStudioCode
      settings:
        id: Microsoft.VisualStudioCode
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: ddev
      directives:
        description: Install DDEVFoundation.DDEV
      settings:
        id: DDEVFoundation.DDEV
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: dbeaver
      directives:
        description: Install DBeaver.DBeaver.Community
      settings:
        id: DBeaver.DBeaver.Community
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: bruno
      directives:
        description: Install Bruno.Bruno
      settings:
        id: Bruno.Bruno
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: starship
      directives:
        description: Install Starship.Starship
      settings:
        id: Starship.Starship
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vs-community
      directives:
        description: Install Visual Studio Community
      settings:
        id: Microsoft.VisualStudio.Community
        source: winget

    - resource: Microsoft.VisualStudio.DSC/VSComponents
      id: vs-workloads
      dependsOn:
        - vs-community
      directives:
        description: Visual Studio workloads from community.vsconfig
        allowPrerelease: true
        securityContext: elevated
      settings:
        productId: Microsoft.VisualStudio.Product.Community
        channelId: VisualStudio.18.Release
        vsConfigFile: '${WinGetConfigRoot}\community.vsconfig'
        includeRecommended: true

    # --- Tools --------------------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: powertoys
      directives:
        description: Install Microsoft.PowerToys
      settings:
        id: Microsoft.PowerToys
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: nanazip
      directives:
        description: Install M2Team.NanaZip
      settings:
        id: M2Team.NanaZip
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: localsend
      directives:
        description: Install LocalSend.LocalSend
      settings:
        id: LocalSend.LocalSend
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: windirstat
      directives:
        description: Install WinDirStat.WinDirStat
      settings:
        id: WinDirStat.WinDirStat
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: autohotkey
      directives:
        description: Install AutoHotkey.AutoHotkey
      settings:
        id: AutoHotkey.AutoHotkey
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: eurkey
      directives:
        description: Install SteffenBruentjen.EurKEY
      settings:
        id: SteffenBruentjen.EurKEY
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: obsidian
      directives:
        description: Install Obsidian.Obsidian
      settings:
        id: Obsidian.Obsidian
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: logseq
      directives:
        description: Install Logseq.Logseq
      settings:
        id: Logseq.Logseq
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: onlyoffice
      directives:
        description: Install ONLYOFFICE.DesktopEditors
      settings:
        id: ONLYOFFICE.DesktopEditors
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: synology-drive
      directives:
        description: Install Synology.DriveClient
      settings:
        id: Synology.DriveClient
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: openwhispr
      directives:
        description: Install OpenWhispr.OpenWhispr
      settings:
        id: OpenWhispr.OpenWhispr
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: fastfetch
      directives:
        description: Install Fastfetch-cli.Fastfetch
      settings:
        id: Fastfetch-cli.Fastfetch
        source: winget

    # --- Browsers -----------------------------------------------------------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: firefox-dev
      directives:
        description: Install Mozilla.Firefox.DeveloperEdition.de
      settings:
        id: Mozilla.Firefox.DeveloperEdition.de
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: chromium
      directives:
        description: Install Hibbiki.Chromium
      settings:
        id: Hibbiki.Chromium
        source: winget

    # --- Windows SSH agent for WSL (WSL side: socat + npiperelay.exe) -------------------
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: npiperelay
      directives:
        description: Install npiperelay
      settings:
        id: albertony.npiperelay
        source: winget

    - resource: PSDscResources/Service
      id: ssh-agent
      directives:
        description: OpenSSH agent starts automatically
        securityContext: elevated
      settings:
        Name: ssh-agent
        StartupType: Automatic
        State: Running

    # --- Settings app -------------------------------------------------------------------
    - resource: PSDscResources/Registry
      id: settings-hide-home
      directives:
        description: Hide the Settings home page
        securityContext: elevated
      settings:
        Key: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer
        ValueName: SettingsPageVisibility
        ValueType: String
        ValueData: "hide:home"
        Force: true

    # --- Error reporting, silent app installs -------------------------------------------
    - resource: PSDscResources/Registry
      id: wer-disabled
      directives:
        description: Disable Windows Error Reporting
        securityContext: elevated
      settings:
        Key: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\Windows Error Reporting
        ValueName: Disabled
        ValueType: Dword
        ValueData: "1"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-silent-installed-apps
      directives:
        description: No silently installed suggested apps
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SilentInstalledAppsEnabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    # --- Suggestions and tips -----------------------------------------------------------
    - resource: PSDscResources/Registry
      id: cdm-system-pane-suggestions
      directives:
        description: No suggestions in Start / Settings
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SystemPaneSuggestionsEnabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-338388
      directives:
        description: Suggestions (SubscribedContent-338388)
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SubscribedContent-338388Enabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-338389
      directives:
        description: Tips and tricks (SubscribedContent-338389)
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SubscribedContent-338389Enabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-338393
      directives:
        description: Suggested content in Settings (SubscribedContent-338393)
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SubscribedContent-338393Enabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-353694
      directives:
        description: Suggested content in Settings (SubscribedContent-353694)
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SubscribedContent-353694Enabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-353696
      directives:
        description: Suggested content in Settings (SubscribedContent-353696)
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SubscribedContent-353696Enabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: cdm-soft-landing
      directives:
        description: No tips about Windows features
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
        ValueName: SoftLandingEnabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    # --- Nags -----------------------------------------------------------------------------
    - resource: PSDscResources/Registry
      id: scoobe
      directives:
        description: No "finish setting up your device" screen after updates
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\UserProfileEngagement
        ValueName: ScoobeSystemSettingEnabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: start-account-notifications
      directives:
        description: No account notifications in Start
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
        ValueName: Start_AccountNotifications
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: siuf-never
      directives:
        description: Feedback frequency never
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Siuf\Rules
        ValueName: NumberOfSIUFInPeriod
        ValueType: Dword
        ValueData: "0"
        Force: true

    # --- Privacy --------------------------------------------------------------------------
    - resource: PSDscResources/Registry
      id: tailored-experiences
      directives:
        description: No tailored experiences from diagnostic data
      settings:
        Key: HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Privacy
        ValueName: TailoredExperiencesWithDiagnosticDataEnabled
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: input-restrict-text
      directives:
        description: No implicit typing data collection
      settings:
        Key: HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization
        ValueName: RestrictImplicitTextCollection
        ValueType: Dword
        ValueData: "1"
        Force: true

    - resource: PSDscResources/Registry
      id: input-restrict-ink
      directives:
        description: No implicit inking data collection
      settings:
        Key: HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization
        ValueName: RestrictImplicitInkCollection
        ValueType: Dword
        ValueData: "1"
        Force: true

    - resource: PSDscResources/Registry
      id: input-harvest-contacts
      directives:
        description: Do not harvest contacts for input personalization
      settings:
        Key: HKEY_CURRENT_USER\Software\Microsoft\InputPersonalization\TrainedDataStore
        ValueName: HarvestContacts
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: personalization-privacy-policy
      directives:
        description: Inking and typing personalization off
      settings:
        Key: HKEY_CURRENT_USER\Software\Microsoft\Personalization\Settings
        ValueName: AcceptedPrivacyPolicy
        ValueType: Dword
        ValueData: "0"
        Force: true

    # --- Network --------------------------------------------------------------------------
    - resource: PSDscResources/Registry
      id: delivery-optimization
      directives:
        description: Updates only from Microsoft, no peer-to-peer
        securityContext: elevated
      settings:
        Key: HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DeliveryOptimization
        ValueName: DODownloadMode
        ValueType: Dword
        ValueData: "0"
        Force: true

    - resource: PSDscResources/Registry
      id: wifi-sense-hotspots
      directives:
        description: No auto-connect to open hotspots
        securityContext: elevated
      settings:
        Key: HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\WcmSvc\wifinetworkmanager\config
        ValueName: AutoConnectAllowedOEM
        ValueType: Dword
        ValueData: "0"
        Force: true
